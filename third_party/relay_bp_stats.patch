+    /// synbuf instrumentation: per-shot statistics row
+    /// [converged, total_iterations, first_conv_iterations, num_legs, obs_best_mask, obs_first_mask]
+    /// Observable masks are bit-packed into a u64 (requires <= 64 observables).
+    pub fn decode_stats(&mut self, detectors: ArrayView1<Bit>) -> Array1<u64> {
+        let r = self.decode_detailed(detectors.view());
+        let pack = |obs: &Array1<Bit>| -> u64 {
+            let mut m: u64 = 0;
+            for (i, b) in obs.iter().enumerate() {
+                if *b != 0 {
+                    m |= 1u64 << i;
+                }
+            }
+            m
+        };
+        let obs_best = pack(&self.compute_observables(r.decoding.view()));
+        let (first_it, legs, obs_first) = match &r.extra {
+            crate::decoder::BPExtraResult::Relay {
+                first_conv_iterations,
+                num_legs,
+                first_decoding,
+            } => (
+                *first_conv_iterations as u64,
+                *num_legs as u64,
+                match first_decoding {
+                    Some(fd) => pack(&self.compute_observables(fd.view())),
+                    None => obs_best,
+                },
+            ),
+            _ => (r.iterations as u64, 1u64, obs_best),
+        };
+        Array1::from(vec![
+            r.success as u64,
+            r.iterations as u64,
+            first_it,
+            legs,
+            obs_best,
+            obs_first,
+        ])
+    }
+
