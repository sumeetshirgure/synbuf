+            .collect();
+        stack(Axis(0), &arrs.iter().map(|a| a.view()).collect::<Vec<_>>()).unwrap()
+    }
+
+    pub fn decode_stats_batch(&mut self, detectors: ArrayView2<Bit>) -> Array2<u64> {
