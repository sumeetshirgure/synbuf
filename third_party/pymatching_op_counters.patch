diff --git a/src/pymatching/sparse_blossom/op_counters.h b/src/pymatching/sparse_blossom/op_counters.h
new file mode 100644
index 0000000..a708744
--- /dev/null
+++ b/src/pymatching/sparse_blossom/op_counters.h
@@ -0,0 +1,25 @@
+// synbuf instrumentation: elementary-operation counters for Sparse Blossom.
+#ifndef PYMATCHING2_OP_COUNTERS_H
+#define PYMATCHING2_OP_COUNTERS_H
+
+#include <cstdint>
+
+namespace pm {
+
+struct OpCounters {
+    uint64_t pq_pops = 0;          // every priority-queue dequeue (incl. stale/invalidated events)
+    uint64_t flood_events = 0;     // valid tentative flooder events processed
+    uint64_t mwpm_events = 0;      // notifications handed to the matcher (region/boundary hits, blossom ops)
+    uint64_t node_reschedules = 0; // detector-node rescheduling operations (region growth/shrink/blossom bookkeeping)
+    uint64_t shatter_ops = 0;      // match-extraction work (blossom shattering calls)
+    void reset() { *this = OpCounters(); }
+};
+
+inline OpCounters &op_counters() {
+    static thread_local OpCounters c;
+    return c;
+}
+
+}  // namespace pm
+
+#endif
