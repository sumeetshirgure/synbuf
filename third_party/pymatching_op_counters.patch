diff --git a/src/pymatching/sparse_blossom/op_counters.h b/src/pymatching/sparse_blossom/op_counters.h
new file mode 100644
index 00000000..0664dd5b
--- /dev/null
+++ b/src/pymatching/sparse_blossom/op_counters.h
@@ -0,0 +1,38 @@
+// synbuf instrumentation: elementary-operation counters for Sparse Blossom.
+//
+// Every counter counts operations of bounded cost (O(1), or O(max node degree)), so the total decode
+// time is within constant factors of their sum.
+#ifndef PYMATCHING2_OP_COUNTERS_H
+#define PYMATCHING2_OP_COUNTERS_H
+
+#include <cstdint>
+
+namespace pm {
+
+struct OpCounters {
+    // dual (flooder)
+    uint64_t pq_pops = 0;          // every priority-queue dequeue (incl. stale/invalidated events)
+    uint64_t queue_moves = 0;      // radix-heap bucket refills: events scanned for the minimum + events moved
+    uint64_t flood_events = 0;     // valid tentative flooder events processed
+    uint64_t node_reschedules = 0; // detector-node rescheduling operations (each scans <= degree neighbors)
+    uint64_t neighbor_scans = 0;   // neighbor iterations inside node rescheduling
+    // primal (matcher)
+    uint64_t mwpm_events = 0;      // notifications handed to the matcher (region/boundary hits, blossom shatter)
+    uint64_t tree_ops = 0;         // alternating-tree node visits and child-list element operations
+    uint64_t region_ops = 0;       // region visits (blossom recursion, blossom cycles, blossom-parent chain steps)
+    uint64_t node_visits = 0;      // detector-node visits by region-wide operations (growth-rate changes, blossom
+                                   // wrapping/unwrapping, shell cleanup)
+    // match extraction
+    uint64_t shatter_ops = 0;      // top-level extraction calls (one per detection event still owned by a region)
+    uint64_t extract_ops = 0;      // recursive extraction steps (shatter calls, blossom-child pairing/scans)
+    void reset() { *this = OpCounters(); }
+};
+
+inline OpCounters &op_counters() {
+    static thread_local OpCounters c;
+    return c;
+}
+
+}  // namespace pm
+
+#endif
