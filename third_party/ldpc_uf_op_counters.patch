+    def decode_batch_with_op_counts(self, syndromes, edge_obs, llrs=None, int bits_per_step=0):
+        """
+        synbuf: decode a batch of syndromes and return per-shot op counters.
+
+        Parameters
+        ----------
+        syndromes : np.ndarray
+            (shots, m) array of syndrome bits (uint8 / bool).
+        edge_obs : np.ndarray
+            (n,) uint64 array; bit k of edge_obs[j] is set if bit j flips logical observable k.
+        llrs : np.ndarray, optional
+            Bit weights used to order cluster growth (see `decode`).
+        bits_per_step : int, optional
+            As in `decode`; 0 adds all neighbouring bits in each growth step.
+
+        Returns
+        -------
+        (np.ndarray, np.ndarray)
+            Predicted observable masks (shots,) uint64 and op counters (shots, 9) uint64 with columns
+            [clusters_created, growth_rounds, cluster_grows, bits_added, merges, merge_moves,
+            cluster_scans, peel_steps, cluster_solves].
+        """
+        cdef np.ndarray[np.uint8_t, ndim=2] syn = np.ascontiguousarray(syndromes, dtype=np.uint8)
+        cdef np.ndarray[np.uint64_t, ndim=1] eo = np.ascontiguousarray(edge_obs, dtype=np.uint64)
+        if syn.shape[1] != self.m:
+            raise ValueError(f"The syndromes must have {self.m} columns. Not {syn.shape[1]}.")
+        if eo.shape[0] != self.n:
+            raise ValueError(f"edge_obs must have length {self.n}. Not {eo.shape[0]}.")
+        cdef Py_ssize_t shots = syn.shape[0]
+        cdef np.ndarray[np.uint64_t, ndim=1] pred = np.zeros(shots, dtype=np.uint64)
+        cdef np.ndarray[np.uint64_t, ndim=2] cnt = np.zeros((shots, 9), dtype=np.uint64)
+        cdef Py_ssize_t s
+        cdef int i
+        cdef bint use_llrs = llrs is not None
+        cdef unsigned long long mask
+        cdef bint nonzero
+        if use_llrs:
+            if not len(llrs) == self.n:
+                raise ValueError(f"The llrs must have length {self.n}. Not {len(llrs)}.")
+            for i in range(self.n):
+                self.uf_llrs[i] = llrs[i]
+        self.bits_per_step = self.n if bits_per_step == 0 else bits_per_step
+        for s in range(shots):
+            op_counters().reset()
+            nonzero = False
+            for i in range(self.m):
+                self._syndrome[i] = syn[s, i]
+                if syn[s, i]:
+                    nonzero = True
+            mask = 0
+            if nonzero:
+                if self.uf_method:
+                    self.ufd.decoding = self.ufd.matrix_decode(self._syndrome, self.uf_llrs if use_llrs else EMPTY_DOUBLE_VECTOR, self.bits_per_step)
+                else:
+                    self.ufd.decoding = self.ufd.peel_decode(self._syndrome, self.uf_llrs if use_llrs else EMPTY_DOUBLE_VECTOR, self.bits_per_step)
+                for i in range(self.n):
+                    if self.ufd.decoding[i]:
+                        mask ^= eo[i]
+            pred[s] = mask
+            c = op_counters()
+            cnt[s, 0] = c.clusters_created
+            cnt[s, 1] = c.growth_rounds
+            cnt[s, 2] = c.cluster_grows
+            cnt[s, 3] = c.bits_added
+            cnt[s, 4] = c.merges
+            cnt[s, 5] = c.merge_moves
+            cnt[s, 6] = c.cluster_scans
+            cnt[s, 7] = c.peel_steps
+            cnt[s, 8] = c.cluster_solves
+        return pred, cnt
+
